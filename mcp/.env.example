# MCP Sidecar Configuration

# Server port (Clowder private web port is 10000)
PORT=8001

# Prometheus metrics port (Clowder ServiceMonitor scrapes this; 9000 in all current envs)
METRICS_PORT=9000

# Widget Layout API URL (main Go application)
WIDGET_LAYOUT_API_URL=http://localhost:8000

# Logging level: trace, debug, info, warn, error, fatal (case-insensitive; unknown values fall back to info)
LOG_LEVEL=info

# Node environment: development, production, test
NODE_ENV=development
